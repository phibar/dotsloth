{
  "name": "@phibar/dotsloth",
  "description": "Sync your dots, be a sloth - Dev environment sync CLI for macOS",
  "version": "0.3.0",
  "author": "phibar",
  "bin": {
    "dotsloth": "./bin/run.js",
    ".sloth": "./bin/run.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/phibar/dotsloth/issues",
  "dependencies": {
    "@oclif/core": "^5.1.2",
    "@oclif/plugin-help": "^7.0.2",
    "chalk": "^6.0.1",
    "enquirer": "^2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@oclif/test": "^5.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10",
    "@types/node": "^26.6.4",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "oclif": "^6.0.2",
    "shx": "^0.4.0",
    "ts-node": "^10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/phibar/dotsloth",
  "keywords": [
    "oclif",
    "dotfiles",
    "macos",
    "icloud",
    "sync",
    "cli",
    "git",
    "ssh",
    "keychain"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "dotsloth",
    "dirname": "dotsloth",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "org": {
        "description": "Manage GitHub organizations and git identities"
      },
      "secret": {
        "description": "Manage secrets in macOS Keychain"
      },
      "env": {
        "description": "Manage machine-local env files (.env and friends)"
      },
      "daemon": {
        "description": "Manage the periodic background sync"
      },
      "claude": {
        "description": "Share Claude Code settings, memory and history between machines"
      },
      "mail": {
        "description": "Back up and restore Mail accounts, rules and signatures"
      }
    }
  },
  "repository": "phibar/dotsloth",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "changeset": "changeset",
    "lint": "biome check",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "release": "changeset publish",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "changeset version && oclif readme && git add README.md CHANGELOG.md"
  },
  "types": "dist/index.d.ts"
}
